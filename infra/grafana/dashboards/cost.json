{
  "annotations": { "list": [] },
  "editable": true,
  "uid": "callscope-cost",
  "title": "CallScope Cost & Sessions",
  "tags": ["callscope", "cost"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Sessions / hour",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(callscope_calls_total[1h]))",
          "legendFormat": "calls_1h",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active calls",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "callscope_active_calls",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM spend (USD, from eval exporter)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "callscope_llm_spend_usd",
          "legendFormat": "spend",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Provider errors",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(callscope_provider_errors_total[5m])) by (stage)",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    }
  ]
}
