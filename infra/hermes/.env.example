# Copy to HERMES_HOME/.env — never commit real keys.
# Reuse the same Token Factory key as the repo root `.env` (TOKEN_FACTORY_API_KEY).
API_SERVER_ENABLED=true
API_SERVER_KEY=changeme-hermes-api
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642

# Export before starting Hermes (do not put real values in this file):
#   export TOKEN_FACTORY_API_KEY=...
#   export OPENAI_API_KEY=$TOKEN_FACTORY_API_KEY
#   export OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
