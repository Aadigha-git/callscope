# Copy to .env (git-ignored). Never commit real values. Local-dev defaults only.
CALLSCOPE_ENV=dev                      # dev | test | staging | demo
CALLSCOPE_LOG_LEVEL=INFO
CALLSCOPE_LOG_JSON=true
CALLSCOPE_METRICS_PORT=9100

# Postgres (local docker-compose defaults)
POSTGRES_PASSWORD=callscope_dev
CALLSCOPE_DATABASE_URL=postgresql://callscope:callscope_dev@127.0.0.1:5432/callscope

# Object store (MinIO local defaults)
MINIO_ROOT_USER=callscope
MINIO_ROOT_PASSWORD=callscope_dev_secret
CALLSCOPE_S3_ENDPOINT=http://127.0.0.1:9000
CALLSCOPE_S3_BUCKET=callscope

# Hermes API server (fill after spike S-2 / task T-M1-09)
CALLSCOPE_HERMES_BASE_URL=http://127.0.0.1:8642
CALLSCOPE_HERMES_API_KEY=changeme-local-only

# LiveKit (dev keys only; generate real ones for staging/demo)
CALLSCOPE_LIVEKIT_URL=ws://127.0.0.1:7880
CALLSCOPE_LIVEKIT_API_KEY=devkey
CALLSCOPE_LIVEKIT_API_SECRET=devsecret-change-me-min-32-chars-long

# Captcha (leave empty in dev: verification is skipped when env=dev)
CALLSCOPE_CAPTCHA_SECRET=
