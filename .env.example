# Copy to .env (git-ignored). Never commit real values. Local-dev defaults only.
CALLSCOPE_ENV=dev                      # dev | test | demo
CALLSCOPE_LOG_LEVEL=INFO
CALLSCOPE_LOG_JSON=true
CALLSCOPE_METRICS_PORT=9100

# Postgres (local docker-compose defaults)
POSTGRES_PASSWORD=callscope_dev
CALLSCOPE_DATABASE_URL=postgresql://callscope:callscope_dev@127.0.0.1:5432/callscope

# Object store (MinIO local defaults; or use local disk and leave unused)
MINIO_ROOT_USER=callscope
MINIO_ROOT_PASSWORD=callscope_dev_secret
CALLSCOPE_S3_ENDPOINT=http://127.0.0.1:9000
CALLSCOPE_S3_BUCKET=callscope
# CALLSCOPE_RECORDINGS_DIR=./data/recordings

# Hermes API server (fill after spikes / T-M1-09)
CALLSCOPE_HERMES_BASE_URL=http://127.0.0.1:8642
CALLSCOPE_HERMES_API_KEY=changeme-local-only

# Nebius Token Factory (OpenAI-compatible). Prefer this name in CallScope code.
# Docs also show NEBIUS_API_KEY — either works if you export both to the same value.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TOKEN_FACTORY_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Optional local OpenAI-compatible fallback (mlx-lm / llama.cpp); best-effort only
# CALLSCOPE_LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# CALLSCOPE_LOCAL_LLM_MODEL=

# LLM budget (USD). Default leaves ~$10 of a $25 Token Factory credit as reserve.
CALLSCOPE_LLM_BUDGET_USD=15
CALLSCOPE_LLM_SPEND_USD=0

# LiveKit (dev keys; livekit-server --dev uses devkey/secret)
CALLSCOPE_LIVEKIT_URL=ws://127.0.0.1:7880
CALLSCOPE_LIVEKIT_API_KEY=devkey
CALLSCOPE_LIVEKIT_API_SECRET=secret

# LangSmith (optional; off by default — fictional scrubbed text only, never audio)
CALLSCOPE_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=callscope

# Toloka (optional stretch; TEXT tasks only)
TOLOKA_API_KEY=
